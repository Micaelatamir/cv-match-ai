# Copie este arquivo para .env e preencha.

# Banco de dados (ao rodar com docker compose, a URL já é definida no compose)
DATABASE_URL=postgresql+psycopg://cvmatch:cvmatch@localhost:5432/cvmatch

# IA (opcional). Sem chave, a API usa sugestões por regras.
# Funciona com qualquer API compatível com a OpenAI (OpenAI, Groq, OpenRouter, Ollama...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
